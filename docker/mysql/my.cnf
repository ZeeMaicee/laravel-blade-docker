# Setelan MySQL 8.4 untuk template ini.
# Dipasang read-only ke /etc/mysql/conf.d/my.cnf

[mysqld]
# utf8mb4 penuh (emoji aman).
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# Zona waktu +07:00 (WIB). Memakai offset, bukan nama zona, supaya tidak perlu
# memuat tabel zona waktu MySQL.
default-time-zone = '+07:00'

# Ketat tapi tidak menyiksa.
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION,ERROR_FOR_DIVISION_BY_ZERO

# Lebih cepat di jaringan container.
skip-name-resolve

# Batas longgar untuk pengembangan.
max_connections     = 200
innodb_buffer_pool_size = 256M

[client]
default-character-set = utf8mb4
