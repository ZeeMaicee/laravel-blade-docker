# =============================================================================
#  .env.example — contoh berkas .env.  JANGAN diisi kredensial sungguhan.
#
#  Cara pakai:
#      cp .env.example .env      # lalu ubah DB_PASSWORD & MYSQL_ROOT_PASSWORD
#      docker compose up -d --build
#
#  Kenapa .env ada di root repo? Karena berkas ini dipakai DUA hal sekaligus:
#    1. docker compose membacanya untuk interpolasi ${VARIABEL} (mis. DB_PASSWORD);
#    2. container memakainya sebagai .env aplikasi Laravel (/var/www/html/.env).
#       entrypoint hanya MENULIS .env sendiri kalau berkas ini tidak ada.
#
#  .env diabaikan git (lihat .gitignore). Committed hanyalah berkas contoh ini.
# =============================================================================

# --- Identitas aplikasi ------------------------------------------------------
APP_NAME="Laravel Blade Docker"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8300
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
# Dibiarkan kosong: entrypoint menjalankan `php artisan key:generate` sendiri.
APP_KEY=

# --- Basis data (MySQL 8.4) --------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
# WAJIB diubah. docker compose menolak jalan kalau baris ini kosong.
DB_PASSWORD=sandi-contoh-jangan-dipakai
MYSQL_ROOT_PASSWORD=sandi-root-contoh-jangan-dipakai

# --- Sesi / cache / antrean --------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Port di komputer Anda (jangan bentrok dengan proyek lain) ---------------
APP_PORT=8300                 # aplikasi  -> http://localhost:8300
DB_PORT_PUBLISHED=3317        # MySQL dari host (opsional, untuk GUI)
VITE_PORT=5273                # server Vite (HMR)

# --- Perilaku entrypoint -----------------------------------------------------
JALANKAN_MIGRASI=true         # true/false — jalankan `php artisan migrate --force`
TANAM_DATA=true               # true/false — jalankan `php artisan db:seed --force` (idempoten)
MULAI_VITE=false              # true/false — jalankan `npm run dev` di dalam container

# --- Log & surat -------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=log

# --- Vite -------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
